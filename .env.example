# Copy to .env.local and adjust. Consumed by app.config.ts at build time,
# so a change here needs a rebuild (or a Metro restart) to take effect.

# Which identity and defaults to build with: development | staging | production
APP_VARIANT=development

# Overrides the variant's default API origin. The /api/v1 prefix is added by the
# API client, so set the origin only.
# Android emulator reaches the host machine at 10.0.2.2, not localhost.
API_ORIGIN=http://localhost:4010
